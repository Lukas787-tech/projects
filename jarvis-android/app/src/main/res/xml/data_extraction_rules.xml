<?xml version="1.0" encoding="utf-8"?>
<!--
  The same, for API 31 and above, which splits cloud backup from the
  phone-to-phone transfer during setup. Keys should survive both.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="jarvis_settings.xml" />
        <include domain="sharedpref" path="jarvis_pool.xml" />
        <exclude domain="sharedpref" path="jarvis_location.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="jarvis_settings.xml" />
        <include domain="sharedpref" path="jarvis_pool.xml" />
        <exclude domain="sharedpref" path="jarvis_location.xml" />
    </device-transfer>
</data-extraction-rules>
