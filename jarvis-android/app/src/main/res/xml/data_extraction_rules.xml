<?xml version="1.0" encoding="utf-8"?>
<!--
  The same, for API 31 and above, which splits cloud backup from the
  phone-to-phone transfer during setup. The keys should survive both, and
  nothing else needs to: an include list is exhaustive, so the cached location
  stays on the phone that measured it.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="jarvis_settings.xml" />
        <include domain="sharedpref" path="jarvis_pool.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="jarvis_settings.xml" />
        <include domain="sharedpref" path="jarvis_pool.xml" />
    </device-transfer>
</data-extraction-rules>
