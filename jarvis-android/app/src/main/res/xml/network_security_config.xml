<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is permitted because the only non-HTTPS endpoint the app ever
         talks to is a LAN address the user types in themselves (an Ollama box at
         192.168.x.x / 10.x.x.x), and those cannot be expressed as a domain rule.
         Every built-in cloud provider endpoint is https:// . -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
