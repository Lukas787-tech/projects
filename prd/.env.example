# --- PRD configuration -------------------------------------------------------
# Copy to .env (never commit the real file) or set these in the PythonAnywhere
# "Web" tab -> "Environment variables", or export them in your WSGI file.

# Flask session signing key. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
PRD_SECRET_KEY=change-me-to-a-long-random-string

# Password for the owner dashboard at /admin
PRD_ADMIN_PASSWORD=change-me

# Salt used when hashing visitor IPs for rate limiting (raw IPs are never stored)
PRD_IP_SALT=change-me-too

# Where the SQLite database and rendered sites live
PRD_DB_PATH=/home/yourusername/prd-data/prd.sqlite3
PRD_SITES_ROOT=/home/yourusername/prd-data/sites

# Public base URL, used to build shareable links
PRD_BASE_URL=https://yourusername.pythonanywhere.com

# auto | local | pythonanywhere
#   auto  -> use PythonAnywhere when a token is present, otherwise local
PRD_DEPLOY_TARGET=auto

# Publish requests are queued for the owner unless this is 1
PRD_AUTO_APPROVE=0

# --- PythonAnywhere API ------------------------------------------------------
# Create at https://www.pythonanywhere.com/account/#api_token
PYTHONANYWHERE_API_TOKEN=
PYTHONANYWHERE_USERNAME=yourusername
# www.pythonanywhere.com or eu.pythonanywhere.com
PYTHONANYWHERE_HOST=www.pythonanywhere.com
# The web app that serves the static files (usually yourusername.pythonanywhere.com)
PYTHONANYWHERE_DOMAIN=yourusername.pythonanywhere.com
# Directory on PythonAnywhere that published sites are written to
PYTHONANYWHERE_SITES_DIR=/home/yourusername/prd-data/sites
# URL prefix mapped to that directory by the static-files mapping
PYTHONANYWHERE_SITES_URL=/sites/

# --- Rate limits (no accounts needed, so these keep the queue sane) ----------
PRD_LIMIT_PUBLISH_HOUR=3
PRD_LIMIT_PUBLISH_DAY=8
PRD_LIMIT_UPDATE_HOUR=20
PRD_LIMIT_PREVIEW_MINUTE=90
PRD_LIMIT_GLOBAL_DAY=250
