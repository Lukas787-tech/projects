    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Rounded indigo tile. -->
    <path
        android:fillColor="#4A56C4"
        android:pathData="M96,48 h96 a48,48 0 0 1 48,48 v96 a48,48 0 0 1 -48,48 h-96 a48,48 0 0 1 -48,-48 v-96 a48,48 0 0 1 48,-48 z" />

