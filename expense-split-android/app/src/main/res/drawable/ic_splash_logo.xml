        android:pathData="M126,96 h36 a7,7 0 0 1 7,7 v70 l-8.4,-5.6 -8.4,5.6 -8.4,-5.6 -8.4,5.6 -8.4,-5.6 -8.4,5.6 v-70 a7,7 0 0 1 7,-7 z" />

    <path
        android:fillColor="#4A56C4"
        android:pathData="M127.4,111.4 h33.6 v5.6 h-33.6 z" />
