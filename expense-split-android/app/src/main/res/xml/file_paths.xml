<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider is allowed to hand out. Scoped to the two directories the app writes to:
  exported reports in the cache, and captured receipt photos in internal storage.
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <files-path name="receipts" path="receipts/" />
</paths>
