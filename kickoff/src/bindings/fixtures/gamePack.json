  "research": {
    "comparables": 5,
    "visual_queries": 3,
    "asset_queries": 4,
    "asset_kinds": [
      "texture",
      "hdri",
      "model",
      "sprite",
      "audio",
      "font",
      "ui"
    ],
    "comparable_query": "{title} video game",
    "refine_fields": [
      "genre",
      "pillars",
      "art_direction",
      "audio_direction",
      "out_of_scope"
